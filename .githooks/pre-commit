#!/bin/bash
# Pre-commit hook: runs SwiftLint on staged Swift files and detekt on staged Kotlin files.
# Install once per clone with: make setup
# To skip (not recommended): git commit --no-verify

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

STAGED=$(git diff --cached --name-only --diff-filter=d)
STAGED_SWIFT=$(echo "$STAGED" | grep '\.swift$' || true)
STAGED_KOTLIN=$(echo "$STAGED" | grep '\.kt$' || true)

# ── SwiftLint (Swift) ───────────────────────────────────────────────────────
if [ -n "$STAGED_SWIFT" ]; then
    SWIFTLINT=""
    if command -v swiftlint > /dev/null 2>&1; then
        SWIFTLINT="swiftlint"
    elif [ -f "/opt/homebrew/bin/swiftlint" ]; then
        SWIFTLINT="/opt/homebrew/bin/swiftlint"
    elif [ -f "/usr/local/bin/swiftlint" ]; then
        SWIFTLINT="/usr/local/bin/swiftlint"
    fi

    if [ -z "$SWIFTLINT" ]; then
        echo "warning: SwiftLint not found — skipping Swift lint. Install with: brew install swiftlint"
    else
        echo "Running SwiftLint..."
        if ! (cd "$REPO_ROOT/iosApp" && $SWIFTLINT lint --strict --baseline swiftlint-baseline.json --config .swiftlint.yml); then
            echo ""
            echo "SwiftLint found errors. Commit blocked."
            echo "Fix the errors above and try again."
            echo "To skip this check (not recommended): git commit --no-verify"
            exit 1
        fi
        echo "SwiftLint passed."
    fi
fi

# ── detekt (Kotlin) ─────────────────────────────────────────────────────────
if [ -n "$STAGED_KOTLIN" ]; then
    echo "Running detekt..."
    if ! (cd "$REPO_ROOT" && ./gradlew detekt --daemon --quiet); then
        echo ""
        echo "detekt found errors. Commit blocked."
        echo "Fix the errors above and try again."
        echo "To skip this check (not recommended): git commit --no-verify"
        exit 1
    fi
    echo "detekt passed."
fi

exit 0
